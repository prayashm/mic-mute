<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: script/build fills in __HOME__. -->
<plist version="1.0">
<dict>
	<key>Label</key><string>local.mic-mute.watch</string>
	<key>ProgramArguments</key><array><string>__HOME__/.local/bin/micwatch</string></array>
	<!-- runs only while muted; MicToggle stops it on unmute -->
	<key>KeepAlive</key>
	<dict><key>PathState</key><dict><key>/tmp/mic_muted</key><true/></dict></dict>
	<!-- cooldown between warnings -->
	<key>ThrottleInterval</key><integer>15</integer>
	<key>StandardErrorPath</key><string>/tmp/mic-mute-watch.log</string>
</dict>
</plist>
